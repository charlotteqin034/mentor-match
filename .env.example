# Copy to .env.local and fill in. Nothing here is optional except the last two.

# Supabase → Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
# The service_role key, NOT the anon key. Server-only; never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# The single password for the organiser console at /admin
ADMIN_PASSWORD=
# Any long random string — signs the admin session cookie. `openssl rand -hex 32`
ADMIN_SESSION_SECRET=

# Optional open-text scoring (§8e). Everything works with this off.
ENABLE_EMBEDDINGS=false
HUGGINGFACE_API_KEY=
